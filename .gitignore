# ============================================================
#  .gitignore  —  C++ 项目专用
# ------------------------------------------------------------
#  作用：告诉 git「这些文件不要纳入版本管理」。
#  被忽略的文件不会出现在 git status 里，也不会被 git add . 提交。
#
#  为什么需要它：编译产物、IDE 配置、系统临时文件都是「本机生成、
#  别人电脑上会重新生成」的东西。提交它们会让仓库又大又乱，
#  而且不同电脑之间还会互相冲突。
#
#  ⚠ 语法坑（重要）：.gitignore 不支持「行尾注释」！
#     下面这样写是错的，规则会失效：
#         *.a    # 静态库        ← 错误！会被当成文件名的一部分
#     注释必须单独占一行，写在规则的上面。
#
#  语法速查：
#    build/        忽略名为 build 的目录（含其中所有内容）
#    *.o           忽略所有以 .o 结尾的文件
#    !important.o  用 ! 开头表示「不忽略」（例外规则）
#    /build        只忽略根目录下的 build，不管子目录里的
#    #             行首的 # 才是注释
# ============================================================


# ============================================================
#  1. 编译中间产物
# ============================================================

# 目标文件
*.o
*.obj
*.lo
*.slo

# 依赖文件（g++ -MMD 生成）
*.d

# 预编译头
*.gch
*.pch
*.pch.d


# ============================================================
#  2. 库文件
# ============================================================

# 静态库：Linux/macOS 用 .a，Windows 用 .lib
*.a
*.lib
*.la
*.lai

# 动态库
*.so
*.so.*
*.dylib
*.dll

# MSVC 链接时产生的附加文件
*.exp
*.pdb
*.ilk
*.idb


# ============================================================
#  3. 可执行文件
# ============================================================

# Windows 上编译出的 .exe 动辄几 MB，提交上去仓库会迅速膨胀，
# 而且对别人毫无用处（源码在他们电脑上重新编译就有了）
*.exe
*.out
*.app
*.msi


# ============================================================
#  4. 构建目录
# ============================================================

# 这些目录整个都是构建系统生成的，可以随时删掉重建
build/
Build/
out/
bin/
obj/
Debug/
Release/
x64/
x86/
cmake-build-*/
cmake-build-debug/
cmake-build-release/
.gradle/


# ============================================================
#  5. CMake 生成物
# ============================================================

# 用 in-source build（在源码目录里直接 cmake .）时会产生这些
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
Testing/
_deps/

# 注意：这里故意【不】写 Makefile 这一条。
# CMake 生成的 Makefile 都躺在 build/ 里（已被第 4 节忽略），
# 而你自己手写的顶层 Makefile 属于源码，必须提交。


# ============================================================
#  6. Visual Studio
# ============================================================

.vs/
*.suo
*.user
*.userosscache
*.aps
*.ncb
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.vcxproj.user
*.vcxproj.filters
*.sln.docstates


# ============================================================
#  7. VS Code
# ============================================================

# 用 .vscode/* 而不是 .vscode/：
# 如果写 .vscode/（排除整个目录），下面的 ! 例外就无效了 ——
# git 的规则是「父目录一旦被排除，就无法再单独放行里面的文件」。
.vscode/*
!.vscode/extensions.json


# ============================================================
#  8. JetBrains CLion
# ============================================================

.idea/
*.iml
*.iws
*.ipr


# ============================================================
#  9. 其它 IDE / 编辑器
# ============================================================

# Eclipse
.cproject
.project
.settings/

# Vim
*.swp
*.swo
.nvimrc

# 编辑器备份文件（很多编辑器保存时会产生 xxx~ ）
*~


# ============================================================
#  10. Windows 系统文件
# ============================================================

Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk


# ============================================================
#  11. macOS 系统文件
# ============================================================

# 如果你要和用 Mac 的同学协作，这些必须加
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes


# ============================================================
#  12. Linux 系统文件
# ============================================================

.directory
.Trash-*


# ============================================================
#  13. 调试与性能分析产物
# ============================================================

# MinGW 下程序崩溃时会生成 .stackdump
*.stackdump

# Valgrind 内存检测
vgcore.*

# Linux perf 性能分析
perf.data
perf.data.old

# gprof 性能分析
*.gmon.out


# ============================================================
#  14. 依赖管理工具
# ============================================================

vcpkg_installed/
conan/
conanbuildinfo.*
.conan/
.cache/


# ============================================================
#  15. 本项目专用：临时输出
# ============================================================

# 性能对比实验会产生大量原始数据。
# 只提交最终报告和结论，不提交中间文件。
data/generated/
data/*_large.txt
bench/results/*.csv

# 通用临时文件
*.log
*.tmp
